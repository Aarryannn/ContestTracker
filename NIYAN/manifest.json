{
  "manifest_version": 3,
  "name": "NiYan Contest Tracker",
  "version": "1.0.0",
  "description": "All of your coding contests are listed here...",
  "host_permissions": [
    "https://codeforces.com/*",
    "https://alfa-leetcode-api.onrender.com/*"
  ],
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Coding Contest Tracker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}